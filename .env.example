# Optional browser Firebase configuration. Leave blank to use local content only.
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=

# Administrative publishing only. Never prefix admin credentials with REACT_APP_.
FIREBASE_PROJECT_ID=
# Keep any service-account JSON outside this repository and point to it here.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/outside/repo/service-account.json
